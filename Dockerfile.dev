FROM node:24-alpine

RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /app

# 依存関係のコピー
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma

# 依存関係のインストール
RUN pnpm install

# ソースコードのコピー
COPY . .

# コンテナのアーキテクチャに合わせて Prisma Client を生成
RUN DATABASE_URL=postgresql://prisma:prisma@localhost:5432/prisma pnpm exec prisma generate

ENV NODE_ENV=development
ENV HOST=0.0.0.0

EXPOSE 3000

# 起動直前にも generate を走らせる（マウントによる上書き対策）
# 開発コンテナも非rootで実行するためのユーザーを作成し、/app の所有権を渡す
RUN addgroup -S nodejs && adduser -S nuxt -G nodejs
RUN chown -R nuxt:nodejs /app

USER nuxt

# 起動直前にも generate を走らせる（マウントによる上書き対策）
CMD ["sh", "-c", "pnpm exec prisma generate && pnpm dev"]

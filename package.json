{
  "name": "pitamai-only",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm exec prisma generate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:deploy": "pnpm exec prisma migrate deploy",
    "generate:better-auth": "pnpm dlx auth@latest generate --config server/utils/auth.ts",
    "migration:better-auth": "pnpm dlx @better-auth/cli migrate --config server/utils/auth.ts",
    "generate:prisma": "pnpm exec prisma generate",
    "migration:prisma": "pnpm exec prisma migrate dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@nuxt/content": "^3.16.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nuxt": "^10.76.2",
    "@sentry/vite-plugin": "^4.9.1",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "import-in-the-middle": "^2.0.6",
    "nuxt": "^4.6.2",
    "nuxt-email-renderer": "2.8.0",
    "nuxt-security": "2.6.0",
    "pg": "^8.23.1",
    "pinia": "^3.0.4",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "resend": "^6.34.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "uuid": "^13.0.2",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/icon": "^2.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  },
  "onlyBuiltDependencies": [
    "@prisma/client",
    "@sentry/cli"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "version": "0.2.0-rc.0"
}
